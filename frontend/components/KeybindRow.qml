import QtQuick
import "../theme"
import "../services"

Rectangle {
    id: root

    property var bindData: null
    property bool isExpanded: false
    property bool isSelected: false
    signal toggleExpand()

    implicitWidth: 600
    implicitHeight: mainCol.implicitHeight + 16

    radius: 8
    color: isExpanded
        ? HKS.alpha(HKS.elevated, 0.75)
        : (mouseArea.containsMouse ? HKS.alpha(HKS.surface, 0.8) : HKS.alpha(HKS.surface, 0.4))

    border.width: 1
    border.color: isExpanded
        ? HKS.alpha(HKS.accent, 0.5)
        : (isSelected ? HKS.alpha(HKS.accent, 0.3) : HKS.alpha(HKS.muted, 0.12))

    Behavior on color { ColorAnimation { duration: 100 } }
    Behavior on border.color { ColorAnimation { duration: 100 } }

    Column {
        id: mainCol
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: parent.top
        anchors.margins: 8
        spacing: 8

        // Top line: Shortcut + Badges + Category
        Item {
            width: parent.width
            height: Math.max(keycapsRow.implicitHeight, Math.max(descCol.implicitHeight, rightPills.implicitHeight))

            // Shortcut keycaps
            Row {
                id: keycapsRow
                anchors.left: parent.left
                anchors.verticalCenter: parent.verticalCenter
                spacing: 4

                Repeater {
                    model: root.bindData ? KeybindData.shortcutParts(root.bindData) : []
                    delegate: Keycap {
                        text: modelData
                    }
                }
            }

            // Description and action
            Column {
                id: descCol
                anchors.left: keycapsRow.right
                anchors.leftMargin: 12
                anchors.right: rightPills.left
                anchors.rightMargin: 12
                anchors.verticalCenter: parent.verticalCenter
                spacing: 2
                clip: true

                Text {
                    width: parent.width
                    text: root.bindData ? KeybindData.descriptionText(root.bindData) : ""
                    font.family: HKS.fontFamily
                    font.pixelSize: HKS.fontSize
                    font.weight: Font.DemiBold
                    color: HKS.fg
                    elide: Text.ElideRight
                }

                Text {
                    width: parent.width
                    text: root.bindData ? KeybindData.actionText(root.bindData) : ""
                    font.family: HKS.fontFamily
                    font.pixelSize: HKS.fontSizeSmall
                    color: HKS.muted
                    elide: Text.ElideRight
                }
            }

            // Right pills: Conflict, Loop, Flags, Category
            Row {
                id: rightPills
                anchors.verticalCenter: parent.verticalCenter
                anchors.right: parent.right
                spacing: 6

                // Conflict badge
                Rectangle {
                    anchors.verticalCenter: parent.verticalCenter
                    visible: !!(root.bindData && root.bindData.conflict_ids && root.bindData.conflict_ids.length > 0)
                    height: 20
                    width: conflictLabel.implicitWidth + 10
                    radius: 4
                    color: HKS.alpha(HKS.warning, 0.2)
                    border.width: 1
                    border.color: HKS.alpha(HKS.warning, 0.6)

                    Text {
                        id: conflictLabel
                        anchors.centerIn: parent
                        text: "stacked"
                        font.family: HKS.fontFamily
                        font.pixelSize: 9
                        font.weight: Font.Bold
                        color: HKS.warning
                    }
                }

                // Generated by loop badge
                Rectangle {
                    anchors.verticalCenter: parent.verticalCenter
                    visible: !!(root.bindData && root.bindData.generated)
                    height: 20
                    width: loopLabel.implicitWidth + 8
                    radius: 4
                    color: HKS.alpha(HKS.muted, 0.15)
                    border.width: 1
                    border.color: HKS.alpha(HKS.muted, 0.3)

                    Text {
                        id: loopLabel
                        anchors.centerIn: parent
                        text: "loop"
                        font.family: HKS.fontFamily
                        font.pixelSize: 9
                        color: HKS.muted
                    }
                }

                // Flags (mouse, release, locked, repeating, long_press)
                Repeater {
                    model: {
                        if (!root.bindData || !root.bindData.flags) return [];
                        var activeFlags = [];
                        var f = root.bindData.flags;
                        if (f.mouse) activeFlags.push("mouse");
                        if (f.release) activeFlags.push("release");
                        if (f.locked) activeFlags.push("locked");
                        if (f.repeating) activeFlags.push("repeat");
                        if (f.long_press) activeFlags.push("long");
                        return activeFlags;
                    }

                    delegate: Rectangle {
                        anchors.verticalCenter: parent.verticalCenter
                        height: 20
                        width: flagTxt.implicitWidth + 8
                        radius: 4
                        color: HKS.alpha(HKS.muted, 0.12)

                        Text {
                            id: flagTxt
                            anchors.centerIn: parent
                            text: modelData
                            font.family: HKS.fontFamily
                            font.pixelSize: 9
                            color: HKS.muted
                        }
                    }
                }

                // Category tag
                Rectangle {
                    anchors.verticalCenter: parent.verticalCenter
                    height: 22
                    width: catLabel.implicitWidth + 12
                    radius: 11
                    color: HKS.alpha(HKS.accent, 0.15)
                    border.width: 1
                    border.color: HKS.alpha(HKS.accent, 0.3)

                    Text {
                        id: catLabel
                        anchors.centerIn: parent
                        text: root.bindData ? (root.bindData.category || "Other") : ""
                        font.family: HKS.fontFamily
                        font.pixelSize: 10
                        font.weight: Font.DemiBold
                        color: HKS.accent
                    }
                }
            }
        }

        // Expanded details section
        Rectangle {
            width: parent.width
            height: root.isExpanded ? detailsCol.implicitHeight + 16 : 0
            visible: root.isExpanded
            clip: true
            radius: 6
            color: HKS.alpha(HKS.bg, 0.7)
            border.width: 1
            border.color: HKS.alpha(HKS.muted, 0.18)

            Column {
                id: detailsCol
                anchors.left: parent.left
                anchors.right: parent.right
                anchors.top: parent.top
                anchors.margins: 8
                spacing: 6

                Row {
                    spacing: 8
                    Text {
                        text: "Source:"
                        font.family: HKS.fontFamily
                        font.pixelSize: HKS.fontSizeSmall
                        font.weight: Font.Bold
                        color: HKS.muted
                    }
                    TextEdit {
                        text: root.bindData ? (root.bindData.source_file + ":" + root.bindData.source_line) : ""
                        font.family: HKS.fontFamily
                        font.pixelSize: HKS.fontSizeSmall
                        color: HKS.fg
                        readOnly: true
                        selectByMouse: true
                    }
                }

                Row {
                    spacing: 8
                    Text {
                        text: "Config:"
                        font.family: HKS.fontFamily
                        font.pixelSize: HKS.fontSizeSmall
                        font.weight: Font.Bold
                        color: HKS.muted
                    }
                    TextEdit {
                        text: root.bindData ? (root.bindData.original_line || "") : ""
                        font.family: HKS.fontFamily
                        font.pixelSize: HKS.fontSizeSmall
                        color: HKS.accent
                        readOnly: true
                        selectByMouse: true
                    }
                }

                Row {
                    spacing: 8
                    visible: !!(root.bindData && root.bindData.submap)
                    Text {
                        text: "Submap:"
                        font.family: HKS.fontFamily
                        font.pixelSize: HKS.fontSizeSmall
                        font.weight: Font.Bold
                        color: HKS.muted
                    }
                    Text {
                        text: root.bindData ? (root.bindData.submap || "") : ""
                        font.family: HKS.fontFamily
                        font.pixelSize: HKS.fontSizeSmall
                        color: HKS.fg
                    }
                }
            }
        }
    }

    MouseArea {
        id: mouseArea
        anchors.fill: parent
        hoverEnabled: true
        cursorShape: Qt.PointingHandCursor
        onClicked: root.toggleExpand()
    }
}
