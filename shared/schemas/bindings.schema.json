{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyprland-keybind-studio.local/schemas/bindings.schema.json",
  "title": "Hyprland Keybind Studio Normalized Scan Output (v1)",
  "type": "object",
  "required": [
    "schema_version",
    "tool",
    "generated_at",
    "environment",
    "files",
    "binds",
    "unbinds",
    "diagnostics",
    "stats",
    "complete"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "tool": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "generated_at": {
      "type": "string",
      "minLength": 10
    },
    "environment": {
      "type": "object",
      "required": [
        "config_dir",
        "entrypoint",
        "entrypoint_source",
        "language",
        "detected_by",
        "shadowed",
        "python"
      ],
      "additionalProperties": false,
      "properties": {
        "config_dir": { "type": "string", "minLength": 1 },
        "entrypoint": { "type": "string", "minLength": 1 },
        "entrypoint_source": {
          "type": "string",
          "enum": ["auto", "explicit"]
        },
        "language": { "type": "string", "enum": ["lua", "hyprlang"] },
        "detected_by": {
          "type": "string",
          "enum": ["file-precedence", "live-hyprctl"]
        },
        "shadowed": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "reason"],
            "additionalProperties": false,
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        },
        "hyprland_version": { "type": ["string", "null"] },
        "python": { "type": "string", "minLength": 1 }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "real_path", "role", "sha256", "line_count"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "real_path": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "enum": ["entrypoint", "loaded"] },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "line_count": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "binds": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "language",
          "bind_type",
          "declared_via",
          "modifiers",
          "modifiers_raw",
          "modmask",
          "key",
          "key_kind",
          "keys_raw",
          "flags",
          "flags_extra",
          "description",
          "description_effective",
          "category",
          "category_source",
          "dispatcher",
          "submap",
          "source_file",
          "source_line",
          "original_line",
          "original_line_number",
          "generated",
          "occurrence",
          "occurrences_at_site",
          "trace",
          "parse_status"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^b_[0-9a-f]{12}$" },
          "language": { "type": "string", "enum": ["lua", "hyprlang"] },
          "bind_type": { "type": "string", "minLength": 4 },
          "declared_via": { "type": ["string", "null"] },
          "modifiers": {
            "type": "array",
            "items": { "type": "string" }
          },
          "modifiers_raw": { "type": "string" },
          "modmask": { "type": "integer", "minimum": 0 },
          "key": { "type": "string" },
          "key_kind": {
            "type": "string",
            "enum": ["keysym", "mouse_button", "keycode", "mouse_wheel"]
          },
          "key_raw": { "type": "string" },
          "keys_raw": { "type": "string" },
          "args_raw": { "type": "string" },
          "flags": {
            "type": "object",
            "required": [
              "ignore_mods",
              "locked",
              "long_press",
              "mouse",
              "non_consuming",
              "release",
              "repeating",
              "transparent"
            ],
            "additionalProperties": false,
            "properties": {
              "ignore_mods": { "type": "boolean" },
              "locked": { "type": "boolean" },
              "long_press": { "type": "boolean" },
              "mouse": { "type": "boolean" },
              "non_consuming": { "type": "boolean" },
              "release": { "type": "boolean" },
              "repeating": { "type": "boolean" },
              "transparent": { "type": "boolean" }
            }
          },
          "flags_extra": {
            "type": "object"
          },
          "description": { "type": ["string", "null"] },
          "description_effective": {
            "type": "object",
            "required": ["text", "source", "generic"],
            "additionalProperties": false,
            "properties": {
              "text": { "type": "string" },
              "source": {
                "type": "string",
                "enum": ["sidecar", "config", "derived"]
              },
              "generic": { "type": "boolean" }
            }
          },
          "category": {
            "type": "string",
            "enum": [
              "Apps",
              "Windows",
              "Workspaces",
              "Media & Hardware",
              "System",
              "Mouse",
              "Other"
            ]
          },
          "category_source": {
            "type": "string",
            "enum": ["sidecar", "derived"]
          },
          "dispatcher": {
            "type": "object",
            "required": ["path", "args", "arg_summary"],
            "additionalProperties": false,
            "properties": {
              "path": { "type": "string" },
              "args": { "type": "array" },
              "arg_summary": { "type": "string" },
              "callback_line": { "type": ["integer", "null"] }
            }
          },
          "submap": { "type": "string" },
          "source_file": { "type": "string", "minLength": 1 },
          "source_line": { "type": "integer", "minimum": 0 },
          "original_line": { "type": "string" },
          "original_line_number": { "type": "integer", "minimum": 0 },
          "generated": { "type": "boolean" },
          "occurrence": { "type": "integer", "minimum": 0 },
          "occurrences_at_site": { "type": "integer", "minimum": 1 },
          "trace": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["file", "line", "what", "istailcall"],
              "additionalProperties": false,
              "properties": {
                "file": { "type": "string", "minLength": 1 },
                "line": { "type": "integer", "minimum": 0 },
                "what": { "type": "string" },
                "istailcall": { "type": "boolean" }
              }
            }
          },
          "parse_status": {
            "type": "string",
            "enum": ["ok", "partial", "unsupported", "unresolved"]
          }
        }
      }
    },
    "unbinds": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "modifiers",
          "modifiers_raw",
          "modmask",
          "key",
          "key_raw",
          "submap",
          "source_file",
          "source_line",
          "original_line",
          "parse_status"
        ],
        "additionalProperties": false,
        "properties": {
          "modifiers": { "type": "array", "items": { "type": "string" } },
          "modifiers_raw": { "type": "string" },
          "modmask": { "type": "integer", "minimum": 0 },
          "key": { "type": "string" },
          "key_raw": { "type": "string" },
          "submap": { "type": "string" },
          "source_file": { "type": "string", "minLength": 1 },
          "source_line": { "type": "integer", "minimum": 0 },
          "original_line": { "type": "string" },
          "parse_status": {
            "type": "string",
            "enum": ["ok", "partial", "unsupported", "unresolved"]
          }
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["level", "code", "message", "file", "line"],
        "additionalProperties": false,
        "properties": {
          "level": { "type": "string", "enum": ["info", "warning", "error"] },
          "code": { "type": "string", "minLength": 1 },
          "message": { "type": "string" },
          "file": { "type": ["string", "null"] },
          "line": { "type": ["integer", "null"] }
        }
      }
    },
    "stats": {
      "type": "object",
      "required": [
        "total_binds",
        "by_type",
        "by_dispatcher_path",
        "flag_counts",
        "by_modmask",
        "generated_binds",
        "partial",
        "unsupported",
        "unresolved",
        "ignored_calls",
        "ignored_keywords",
        "sidecar"
      ],
      "additionalProperties": false,
      "properties": {
        "total_binds": { "type": "integer", "minimum": 0 },
        "by_type": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "by_dispatcher_path": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "flag_counts": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "by_modmask": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "generated_binds": { "type": "integer", "minimum": 0 },
        "partial": { "type": "integer", "minimum": 0 },
        "unsupported": { "type": "integer", "minimum": 0 },
        "unresolved": { "type": "integer", "minimum": 0 },
        "ignored_calls": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "ignored_keywords": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "sandbox": {
          "type": ["object", "null"],
          "required": [
            "cpu_limit_s",
            "elapsed_ms",
            "instruction_limit",
            "instructions_used",
            "wall_timeout_s"
          ],
          "additionalProperties": false,
          "properties": {
            "cpu_limit_s": { "type": "number", "minimum": 0 },
            "elapsed_ms": { "type": "number", "minimum": 0 },
            "instruction_limit": { "type": "integer", "minimum": 0 },
            "instructions_used": { "type": "integer", "minimum": 0 },
            "wall_timeout_s": { "type": "number", "minimum": 0 }
          }
        },
        "sidecar": {
          "type": "object",
          "required": [
            "path",
            "loaded",
            "overrides",
            "matched",
            "unmatched"
          ],
          "additionalProperties": false,
          "properties": {
            "path": { "type": ["string", "null"] },
            "loaded": { "type": "boolean" },
            "overrides": { "type": "integer", "minimum": 0 },
            "matched": { "type": "integer", "minimum": 0 },
            "unmatched": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "complete": {
      "type": "boolean"
    },
    "oracle": {
      "type": ["object", "null"]
    }
  }
}
