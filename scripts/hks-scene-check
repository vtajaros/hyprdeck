#!/usr/bin/env python3
"""Headless Quickshell scene-warning regression guard for HyprDeck Settings."""

from __future__ import annotations

import json
import os
import subprocess
import sys
import time
from pathlib import Path

_TARGET_FILES = ("InputPage", "DisplayPage", "SettingRow")
_WARN_TOKENS = ("WARN scene:", "ReferenceError", "Unable to assign")


def main() -> int:
    repo_root = Path(__file__).resolve().parent.parent
    shell_qml = repo_root / "settings" / "shell.qml"
    env = {
        **os.environ,
        "HKS_START_HIDDEN": "1",
        "HKS_KEEP_ALIVE": "1",
        "HKS_SETTINGS_DEBUG": "1",
        "HYPRDECK_ROOT": str(repo_root),
        "HKS_ROOT": str(repo_root),
    }

    proc = subprocess.Popen(
        ["quickshell", "-p", str(shell_qml)],
        env=env,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
    )
    logs = ""
    try:
        ready = False
        for _ in range(40):
            res = subprocess.run(
                ["quickshell", "ipc", "--pid", str(proc.pid), "show"],
                capture_output=True,
                text=True,
                timeout=3,
            )
            if res.returncode == 0 and "target settings" in res.stdout:
                ready = True
                break
            if proc.poll() is not None:
                break
            time.sleep(0.15)

        if not ready:
            sys.stderr.write("hks-scene-check: Quickshell IPC did not become ready.\n")
            return 1

        # Wait for initial services to finish loading before walking pages/tabs
        for _ in range(30):
            res = subprocess.run(
                ["quickshell", "ipc", "--pid", str(proc.pid), "call", "settings", "debugState"],
                capture_output=True,
                text=True,
                timeout=5,
            )
            if res.returncode == 0:
                st = json.loads(res.stdout.strip())
                if not (st["display"]["loading"] or st["input"]["loading"]):
                    break
            time.sleep(0.15)

        subprocess.run(
            ["quickshell", "ipc", "--pid", str(proc.pid), "call", "settings", "navigate", "display"],
            check=True,
            capture_output=True,
            text=True,
            timeout=5,
        )
        time.sleep(0.2)

        subprocess.run(
            ["quickshell", "ipc", "--pid", str(proc.pid), "call", "settings", "navigate", "input"],
            check=True,
            capture_output=True,
            text=True,
            timeout=5,
        )
        for tab_name, xkb_expanded in (
            ("keyboard", "true"),
            ("mouse", "false"),
            ("touchpad", "false"),
            ("devices", "false"),
        ):
            subprocess.run(
                [
                    "quickshell",
                    "ipc",
                    "--pid",
                    str(proc.pid),
                    "call",
                    "settings",
                    "debugSetInputView",
                    tab_name,
                    xkb_expanded,
                ],
                check=True,
                capture_output=True,
                text=True,
                timeout=5,
            )
            time.sleep(0.15)
    finally:
        proc.terminate()
        try:
            logs, _ = proc.communicate(timeout=5)
        except subprocess.TimeoutExpired:
            proc.kill()
            logs, _ = proc.communicate(timeout=5)

    offending: list[str] = []
    for line in logs.splitlines():
        if any(tok in line for tok in _WARN_TOKENS) and any(f in line for f in _TARGET_FILES):
            offending.append(line.strip())

    if offending:
        sys.stderr.write(
            f"hks-scene-check: FAILED ({len(offending)} scene warning(s) in InputPage/DisplayPage/SettingRow):\n"
        )
        for ln in offending:
            sys.stderr.write(f"  {ln}\n")
        return 1

    print("hks-scene-check: passed (0 scene warnings in InputPage, DisplayPage, SettingRow).")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
