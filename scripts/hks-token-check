#!/usr/bin/env bash
set -euo pipefail
SELF_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
if [ "${HYPRDECK_WARN_DEPRECATED:-0}" = "1" ]; then
    echo "$(basename "${BASH_SOURCE[0]}") is deprecated; use hyprdeck-token-check instead." >&2
fi
exec "$SELF_DIR/hyprdeck-token-check" "$@"
