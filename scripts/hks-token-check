#!/usr/bin/env python3
"""Static guard ensuring every Deck.<token> used in QML is defined in frontend/theme/Deck.qml."""

from __future__ import annotations

import re
import sys
from pathlib import Path

_PROP_RE = re.compile(r"(?:readonly\s+)?property\s+\S+\s+(\w+)\s*:")
_FUNC_RE = re.compile(r"function\s+(\w+)\s*\(")
_USE_RE = re.compile(r"\bDeck\.(\w+)\b")


def main() -> int:
    repo_root = Path(__file__).resolve().parent.parent
    deck_qml = repo_root / "frontend" / "theme" / "Deck.qml"
    deck_text = deck_qml.read_text(encoding="utf-8")

    defined = set(_PROP_RE.findall(deck_text)) | set(_FUNC_RE.findall(deck_text))
    offenders: list[str] = []

    for sub in ("frontend", "settings"):
        for qml_path in sorted((repo_root / sub).rglob("*.qml")):
            rel = qml_path.relative_to(repo_root)
            for lineno, line in enumerate(qml_path.read_text(encoding="utf-8").splitlines(), 1):
                for match in _USE_RE.finditer(line):
                    token = match.group(1)
                    if token not in defined:
                        offenders.append(f"  {rel}:{lineno}: undefined Deck.{token}")

    if offenders:
        sys.stderr.write(f"hks-token-check: FAILED ({len(offenders)} undefined Deck.* token(s)):\n")
        for item in offenders:
            sys.stderr.write(item + "\n")
        return 1

    print(f"hks-token-check: passed (all Deck.* references defined in {deck_qml.relative_to(repo_root)}).")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
