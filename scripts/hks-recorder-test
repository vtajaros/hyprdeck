#!/usr/bin/env bash
# =============================================================================
# HyprDeck - Dev Keybind Recorder Test Harness
# =============================================================================
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
FRONTEND_DIR="$REPO_ROOT/frontend"

# Toggle: close if already open
MATCH_PATTERN="[q]uickshell.*$FRONTEND_DIR"

if pgrep -f "$MATCH_PATTERN" >/dev/null 2>&1; then
    quickshell ipc -p "$FRONTEND_DIR" call hks close >/dev/null 2>&1 || true
    for _ in {1..8}; do
        if ! pgrep -f "$MATCH_PATTERN" >/dev/null 2>&1; then
            exit 0
        fi
        sleep 0.04
    done
    pkill -f "$MATCH_PATTERN" 2>/dev/null || true
    exit 0
fi

if ! command -v quickshell >/dev/null 2>&1; then
    echo "Error: quickshell is not installed or not in PATH." >&2
    exit 1
fi

export HKS_ROOT="$REPO_ROOT"
export HYPRDECK_ROOT="${HYPRDECK_ROOT:-$REPO_ROOT}"
export HKS_MODE="recorder-test"
export QML_XHR_ALLOW_FILE_READ=1

exec quickshell -p "$FRONTEND_DIR" "$@"
