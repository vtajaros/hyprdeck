#!/usr/bin/env python3
"""Brand guard ensuring no un-allowlisted HKS / Hyprland Keybind Studio identifiers remain."""

from __future__ import annotations

import fnmatch
import re
import subprocess
import sys
from collections import Counter
from pathlib import Path

_SCAN_RE = re.compile(r"HKS_[A-Z0-9_]+|hks-[a-z0-9-]+|\bhks_record\b|\bHKS\b|\bhks\b|Hyprland Keybind Studio")


def _load_allowlist(path: Path) -> list[tuple[str, str, re.Pattern[str]]]:
    rules: list[tuple[str, str, re.Pattern[str]]] = []
    for raw in path.read_text(encoding="utf-8").splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        parts = [p.strip() for p in line.split("|", 2)]
        if len(parts) != 3:
            raise ValueError(f"Malformed allowlist line: {raw!r}")
        cat, glob_pat, regex_str = parts
        rules.append((cat, glob_pat, re.compile(regex_str)))
    return rules


def _tracked_files(repo_root: Path) -> list[Path]:
    res = subprocess.run(
        ["git", "ls-files"],
        cwd=str(repo_root),
        capture_output=True,
        text=True,
        check=True,
    )
    out: list[Path] = []
    for rel in res.stdout.splitlines():
        if not rel or "__pycache__" in rel or rel.startswith("build/"):
            continue
        p = repo_root / rel
        if p.is_file():
            out.append(p)
    # Also include untracked scripts created in the working tree if any
    for p in sorted((repo_root / "scripts").rglob("*")):
        if p.is_file() and p not in out:
            out.append(p)
    return sorted(set(out))


def main() -> int:
    repo_root = Path(__file__).resolve().parent.parent
    allowlist_path = repo_root / "scripts" / "hyprdeck-brand-allowlist.txt"
    rules = _load_allowlist(allowlist_path)

    counts: Counter[str] = Counter()
    offenders: list[str] = []

    for path in _tracked_files(repo_root):
        rel = path.relative_to(repo_root).as_posix()
        try:
            text = path.read_text(encoding="utf-8")
        except UnicodeDecodeError:
            continue

        file_rules = [(cat, pat) for cat, glob_pat, pat in rules if fnmatch.fnmatch(rel, glob_pat)]

        for lineno, line in enumerate(text.splitlines(), 1):
            for m in _SCAN_RE.finditer(line):
                matched_cat = None
                for cat, pat in file_rules:
                    # Check if the regex matches on the line covering this token
                    for rm in pat.finditer(line):
                        if rm.start() <= m.start() and rm.end() >= m.end():
                            matched_cat = cat
                            break
                        if rm.start() <= m.end() and rm.end() >= m.start():
                            matched_cat = cat
                            break
                    if matched_cat is not None:
                        break
                if matched_cat is not None:
                    counts[matched_cat] += 1
                else:
                    offenders.append(f"  {rel}:{lineno}: {m.group(0)!r} -> {line.strip()[:120]}")

    if offenders:
        sys.stderr.write(f"hyprdeck-brand-check: FAILED ({len(offenders)} un-allowlisted occurrence(s)):\n")
        for item in offenders[:60]:
            sys.stderr.write(item + "\n")
        if len(offenders) > 60:
            sys.stderr.write(f"  ... and {len(offenders) - 60} more\n")
        return 1

    summary = ", ".join(f"{cat}={counts[cat]}" for cat in sorted(counts))
    print(f"hyprdeck-brand-check: passed (0 un-allowlisted; allowlisted: {summary}).")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
