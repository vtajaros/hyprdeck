#!/usr/bin/env python3
"""Privileged sysfs helper for HKS Power settings (EPP & Intel P-state turbo).

Usage:
    hks-power-helper epp <preference>
    hks-power-helper turbo <on|off>

Honors HKS_POWER_SYSFS_ROOT ONLY when run unprivileged (euid != 0) for tests.
When run as root (e.g. via pkexec), sysfs root is always /sys.
"""

from __future__ import annotations

import os
import re
import sys

_CPU_DIR_RE = re.compile(r"^cpu[0-9]+$")


def _resolve_sysfs_root() -> str:
    if os.geteuid() == 0:
        return "/sys"
    override = os.environ.get("HKS_POWER_SYSFS_ROOT", "").strip()
    return os.path.abspath(os.path.expanduser(override)) if override else "/sys"


def _find_cpu_dirs(sysfs_root: str) -> list[str]:
    cpu_base = os.path.join(sysfs_root, "devices", "system", "cpu")
    if not os.path.isdir(cpu_base):
        return []
    dirs: list[str] = []
    for entry in sorted(os.listdir(cpu_base)):
        if _CPU_DIR_RE.match(entry):
            full = os.path.join(cpu_base, entry)
            if os.path.isdir(full):
                dirs.append(full)
    return dirs


def _handle_epp(sysfs_root: str, value: str) -> int:
    cpu_dirs = _find_cpu_dirs(sysfs_root)
    if not cpu_dirs:
        sys.stderr.write("hks-power-helper: no CPU directories found\n")
        return 2

    allowed: list[str] = []
    for cdir in cpu_dirs:
        avail_path = os.path.join(cdir, "cpufreq", "energy_performance_available_preferences")
        if os.path.isfile(avail_path):
            with open(avail_path, "r", encoding="utf-8") as f:
                allowed = [tok for tok in f.read().split() if tok]
            if allowed:
                break

    if not allowed or value not in allowed:
        sys.stderr.write(
            f"hks-power-helper: EPP value {value!r} not in allowed whitelist {allowed!r}\n"
        )
        return 2

    wrote = 0
    for cdir in cpu_dirs:
        pref_path = os.path.join(cdir, "cpufreq", "energy_performance_preference")
        if os.path.isfile(pref_path):
            with open(pref_path, "w", encoding="utf-8") as f:
                f.write(value + "\n")
            wrote += 1

    if wrote == 0:
        sys.stderr.write("hks-power-helper: no writable energy_performance_preference files\n")
        return 2
    return 0


def _handle_turbo(sysfs_root: str, mode: str) -> int:
    if mode not in ("on", "off"):
        sys.stderr.write(f"hks-power-helper: turbo argument must be 'on' or 'off', got {mode!r}\n")
        return 2

    no_turbo_path = os.path.join(sysfs_root, "devices", "system", "cpu", "intel_pstate", "no_turbo")
    if not os.path.isfile(no_turbo_path):
        sys.stderr.write("hks-power-helper: intel_pstate/no_turbo not present\n")
        return 2

    # no_turbo=0 means turbo ON; no_turbo=1 means turbo OFF
    val = "0\n" if mode == "on" else "1\n"
    with open(no_turbo_path, "w", encoding="utf-8") as f:
        f.write(val)
    return 0


def main(argv: list[str] | None = None) -> int:
    args = list(sys.argv[1:] if argv is None else argv)
    if len(args) != 2:
        sys.stderr.write("usage: hks-power-helper {epp <value>|turbo <on|off>}\n")
        return 2

    action, value = args[0], args[1]
    sysfs_root = _resolve_sysfs_root()

    try:
        if action == "epp":
            return _handle_epp(sysfs_root, value)
        if action == "turbo":
            return _handle_turbo(sysfs_root, value)
    except OSError as exc:
        sys.stderr.write(f"hks-power-helper: {exc}\n")
        return 1

    sys.stderr.write(f"hks-power-helper: unknown action {action!r}\n")
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
