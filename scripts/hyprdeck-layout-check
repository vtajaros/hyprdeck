#!/usr/bin/env python3
"""Headless responsive layout audit tool for HyprDeck (Settings, Keybind Studio, Popup, Card)."""

from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
import time
from pathlib import Path

FULL_MATRIX = (
    (1880, 1130, "full"),
    (1240, 1130, "two-thirds"),
    (1030, 1130, "master-55%"),
    (930, 1130, "half"),
    (930, 560, "half-short"),
    (610, 1130, "third"),
    (455, 1130, "quarter"),
    (1326, 738, "laptop-full"),
    (655, 738, "laptop-half"),
    (3400, 1380, "ultrawide"),
)

QUICK_MATRIX = (
    (1880, 1130, "full"),
    (1030, 1130, "master-55%"),
    (930, 1130, "half"),
    (610, 1130, "third"),
    (455, 1130, "quarter"),
)

# (page_id, sub_tab, details_on, expand_all, label)
SETTINGS_PROBES = (
    ("appearance", "", False, False, "appearance"),
    ("desktop", "", False, False, "desktop"),
    ("display", "", False, False, "display"),
    ("input", "keyboard", False, False, "input:keyboard"),
    ("input", "keyboard", False, True, "input:keyboard+xkb"),
    ("input", "mouse", False, False, "input:mouse"),
    ("input", "touchpad", False, False, "input:touchpad"),
    ("input", "devices", False, False, "input:devices"),
    ("audio", "", False, False, "audio"),
    ("audio", "", True, True, "audio:details+inactive"),
    ("bluetooth", "", False, False, "bluetooth"),
    ("network", "", False, False, "network"),
    ("network", "", True, False, "network:details"),
    ("themes", "", False, False, "themes"),
    ("themes", "", True, True, "themes:all+hints"),
    ("power", "", False, False, "power"),
    ("sysinfo", "", False, False, "sysinfo"),
    ("keyboard", "", False, False, "keyboard"),
    ("backups", "", False, False, "backups"),
)

KEYBIND_VIEWS = (
    "all",
    "filters",
    "conflicts",
    "disabled",
    "backups",
    "settings",
    "add",
    "edit",
    "recorder",
    "confirm",
)

POPUP_MATRIX = (
    (760, 560, "popup-default"),
    (420, 560, "popup-compact"),
)

CARD_MATRIX = (
    (760, 560, "bar-card"),
)


def _base_env(repo_root: Path) -> dict[str, str]:
    env = {
        **os.environ,
        "QT_QPA_PLATFORM": "offscreen",
        "HYPRDECK_KEEP_ALIVE": "1",
        "HKS_KEEP_ALIVE": "1",
        "HYPRDECK_SETTINGS_DEBUG": "1",
        "HKS_SETTINGS_DEBUG": "1",
        "HYPRDECK_ROOT": str(repo_root),
        "HKS_ROOT": str(repo_root),
    }
    env.pop("HYPRDECK_START_HIDDEN", None)
    env.pop("HKS_START_HIDDEN", None)
    return env


def _wait_ipc(pid: int, target: str) -> bool:
    for _ in range(40):
        r = subprocess.run(
            ["quickshell", "ipc", "--pid", str(pid), "show"],
            capture_output=True,
            text=True,
            timeout=3,
        )
        if r.returncode == 0 and f"target {target}" in r.stdout:
            return True
        time.sleep(0.15)
    return False


def _audit_settings(repo_root: Path, matrix: tuple[tuple[int, int, str], ...]) -> tuple[list[tuple[str, str, str, str, str]], int]:
    shell_qml = repo_root / "settings" / "shell.qml"
    proc = subprocess.Popen(
        ["quickshell", "-p", str(shell_qml)],
        env=_base_env(repo_root),
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
    )
    violations: list[tuple[str, str, str, str, str]] = []
    try:
        if not _wait_ipc(proc.pid, "settings"):
            return ([("settings", "-", "startup", "quickshell", "IPC did not become ready")], 0)
        for _ in range(40):
            res = subprocess.run(
                ["quickshell", "ipc", "--pid", str(proc.pid), "call", "settings", "debugState"],
                capture_output=True,
                text=True,
                timeout=5,
            )
            if res.returncode == 0:
                st = json.loads(res.stdout.strip())
                if not (
                    st["loading"]
                    or st["display"]["loading"]
                    or st["input"]["loading"]
                    or st["audio"]["loading"]
                    or st["bluetooth"]["loading"]
                    or st["network"]["loading"]
                    or st["themes"]["loading"]
                    or st["power"]["loading"]
                    or st["system"]["loading"]
                    or st["keyboard"]["loading"]
                    or st.get("backups", {}).get("loading", False)
                ):
                    break
            time.sleep(0.15)

        for w, h, tag in matrix:
            size_label = f"{w}x{h} ({tag})"
            first = True
            for page_id, sub_tab, details_on, expand_all, label in SETTINGS_PROBES:
                subprocess.run(
                    [
                        "quickshell", "ipc", "--pid", str(proc.pid), "call", "settings",
                        "debugConfigureLayoutProbe", str(w), str(h), page_id, sub_tab,
                        "true" if details_on else "false", "true" if expand_all else "false",
                    ],
                    check=True, capture_output=True, text=True, timeout=5,
                )
                time.sleep(0.10 if first else 0.06)
                first = False
                aud = subprocess.run(
                    ["quickshell", "ipc", "--pid", str(proc.pid), "call", "settings", "debugAuditCurrentLayout"],
                    check=True, capture_output=True, text=True, timeout=5,
                )
                data = json.loads(aud.stdout.strip())
                for v in data.get("violations", []):
                    violations.append((
                        f"settings:{label}", size_label, v.get("type", ""), v.get("item", ""),
                        f"{v.get('detail', '')} [{v.get('path', '')}]",
                    ))
    finally:
        proc.terminate()
        try:
            logs, _ = proc.communicate(timeout=5)
        except subprocess.TimeoutExpired:
            proc.kill()
            logs, _ = proc.communicate(timeout=5)

    for ln in logs.splitlines():
        if "Binding loop" in ln:
            violations.append(("settings:runtime", "-", "binding_loop", "QML", ln.strip()))
    return violations, len(matrix) * len(SETTINGS_PROBES)


def _audit_frontend_mode(
    repo_root: Path,
    mode: str,
    target_name: str,
    matrix: tuple[tuple[int, int, str], ...],
    views: tuple[str, ...],
) -> tuple[list[tuple[str, str, str, str, str]], int]:
    shell_qml = repo_root / "frontend" / "shell.qml"
    env = _base_env(repo_root)
    env["HYPRDECK_MODE"] = mode
    env["HKS_MODE"] = mode
    proc = subprocess.Popen(
        ["quickshell", "-p", str(shell_qml)],
        env=env,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
    )
    violations: list[tuple[str, str, str, str, str]] = []
    try:
        if not _wait_ipc(proc.pid, "hks"):
            return ([(target_name, "-", "startup", "quickshell", "IPC did not become ready")], 0)
        for _ in range(40):
            res = subprocess.run(
                ["quickshell", "ipc", "--pid", str(proc.pid), "call", "hks", "debugState"],
                capture_output=True, text=True, timeout=5,
            )
            if res.returncode == 0 and not json.loads(res.stdout.strip()).get("loading", True):
                break
            time.sleep(0.15)

        for w, h, tag in matrix:
            size_label = f"{w}x{h} ({tag})"
            first = True
            for v in views:
                cat = "Apps" if v == "filters" else "All"
                subprocess.run(
                    [
                        "quickshell", "ipc", "--pid", str(proc.pid), "call", "hks",
                        "debugConfigureLayoutProbe", str(w), str(h), v, "", cat,
                    ],
                    check=True, capture_output=True, text=True, timeout=5,
                )
                time.sleep(0.10 if first else 0.06)
                first = False
                aud = subprocess.run(
                    ["quickshell", "ipc", "--pid", str(proc.pid), "call", "hks", "debugAuditCurrentLayout"],
                    check=True, capture_output=True, text=True, timeout=5,
                )
                data = json.loads(aud.stdout.strip())
                for item in data.get("violations", []):
                    violations.append((
                        f"{target_name}:{v}", size_label, item.get("type", ""), item.get("item", ""),
                        f"{item.get('detail', '')} [{item.get('path', '')}]",
                    ))
    finally:
        proc.terminate()
        try:
            logs, _ = proc.communicate(timeout=5)
        except subprocess.TimeoutExpired:
            proc.kill()
            logs, _ = proc.communicate(timeout=5)

    for ln in logs.splitlines():
        if "Binding loop" in ln:
            violations.append((f"{target_name}:runtime", "-", "binding_loop", "QML", ln.strip()))
    return violations, len(matrix) * len(views)


def main() -> int:
    parser = argparse.ArgumentParser(description="Headless responsive layout audit tool for HyprDeck.")
    parser.add_argument(
        "--target",
        choices=("settings", "keybind-studio", "popup", "card", "all"),
        default="all",
        help="Target surface(s) to audit (default: all)",
    )
    parser.add_argument(
        "--screenshots",
        action="store_true",
        help="Also generate PNG screenshots + contact sheets via capture_layout_matrix.py",
    )
    args = parser.parse_args()

    repo_root = Path(__file__).resolve().parent.parent
    quick = (os.environ.get("HYPRDECK_LAYOUT_QUICK") or os.environ.get("HKS_LAYOUT_QUICK")) == "1"
    matrix = QUICK_MATRIX if quick else FULL_MATRIX

    all_violations: list[tuple[str, str, str, str, str]] = []
    total_checks = 0

    if args.target in ("settings", "all"):
        viols, n = _audit_settings(repo_root, matrix)
        all_violations.extend(viols)
        total_checks += n
    if args.target in ("keybind-studio", "all"):
        viols, n = _audit_frontend_mode(repo_root, "window", "keybind-studio", matrix, KEYBIND_VIEWS)
        all_violations.extend(viols)
        total_checks += n
    if args.target in ("popup", "all"):
        viols, n = _audit_frontend_mode(repo_root, "popup", "popup", POPUP_MATRIX, ("all",))
        all_violations.extend(viols)
        total_checks += n
    if args.target in ("card", "all"):
        viols, n = _audit_frontend_mode(repo_root, "card", "card", CARD_MATRIX, ("all",))
        all_violations.extend(viols)
        total_checks += n

    if all_violations:
        print(f"hyprdeck-layout-check: {len(all_violations)} violation(s) across {total_checks} target-size-view check(s):")
        print(f"{'VIEW':<28} {'SIZE':<22} {'TYPE':<16} {'ITEM':<32} DETAIL")
        for pg, sz, tp, it, dt in all_violations[:120]:
            print(f"{pg:<28} {sz:<22} {tp:<16} {it[:30]:<32} {dt}")
        if len(all_violations) > 120:
            print(f"... and {len(all_violations) - 120} more")
        return 1

    print(f"hyprdeck-layout-check: passed (0 violations across {total_checks} checks, target={args.target}).")
    if args.screenshots:
        cap_script = repo_root / "scripts" / "ui-capture" / "capture_layout_matrix.py"
        cap_res = subprocess.run([sys.executable, str(cap_script), "--target", args.target], check=False)
        if cap_res.returncode != 0:
            return cap_res.returncode
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
