#!/usr/bin/env python3
"""Headless responsive layout audit tool for HyprDeck Settings."""

from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
import time
from pathlib import Path

FULL_MATRIX = (
    (1880, 1130, "full"),
    (1240, 1130, "two-thirds"),
    (1030, 1130, "master-55%"),
    (930, 1130, "half"),
    (930, 560, "half-short"),
    (610, 1130, "third"),
    (455, 1130, "quarter"),
    (1326, 738, "laptop-full"),
    (655, 738, "laptop-half"),
    (3400, 1380, "ultrawide"),
)

QUICK_MATRIX = (
    (1880, 1130, "full"),
    (1030, 1130, "master-55%"),
    (930, 1130, "half"),
    (610, 1130, "third"),
    (455, 1130, "quarter"),
)

# (page_id, sub_tab, details_on, expand_all, label)
PROBES = (
    ("appearance", "", False, False, "appearance"),
    ("desktop", "", False, False, "desktop"),
    ("display", "", False, False, "display"),
    ("input", "keyboard", False, False, "input:keyboard"),
    ("input", "keyboard", False, True, "input:keyboard+xkb"),
    ("input", "mouse", False, False, "input:mouse"),
    ("input", "touchpad", False, False, "input:touchpad"),
    ("input", "devices", False, False, "input:devices"),
    ("audio", "", False, False, "audio"),
    ("audio", "", True, True, "audio:details+inactive"),
    ("bluetooth", "", False, False, "bluetooth"),
    ("network", "", False, False, "network"),
    ("network", "", True, False, "network:details"),
    ("themes", "", False, False, "themes"),
    ("themes", "", True, True, "themes:all+hints"),
    ("power", "", False, False, "power"),
    ("sysinfo", "", False, False, "sysinfo"),
    ("keyboard", "", False, False, "keyboard"),
)


def main() -> int:
    parser = argparse.ArgumentParser(description="Headless responsive layout audit tool for HyprDeck Settings.")
    parser.add_argument("--screenshots", action="store_true", help="Also generate PNG screenshots + contact sheets via capture_layout_matrix.py")
    args = parser.parse_args()

    repo_root = Path(__file__).resolve().parent.parent
    shell_qml = repo_root / "settings" / "shell.qml"
    quick = os.environ.get("HKS_LAYOUT_QUICK") == "1"
    matrix = QUICK_MATRIX if quick else FULL_MATRIX

    env = {
        **os.environ,
        "QT_QPA_PLATFORM": "offscreen",
        "HKS_KEEP_ALIVE": "1",
        "HKS_SETTINGS_DEBUG": "1",
        "HYPRDECK_ROOT": str(repo_root),
        "HKS_ROOT": str(repo_root),
    }
    env.pop("HKS_START_HIDDEN", None)

    proc = subprocess.Popen(
        ["quickshell", "-p", str(shell_qml)],
        env=env,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
    )
    all_violations: list[tuple[str, str, str, str, str]] = []
    try:
        ready = False
        for _ in range(40):
            r = subprocess.run(
                ["quickshell", "ipc", "--pid", str(proc.pid), "show"],
                capture_output=True,
                text=True,
                timeout=3,
            )
            if r.returncode == 0 and "target settings" in r.stdout:
                ready = True
                break
            if proc.poll() is not None:
                break
            time.sleep(0.15)
        if not ready:
            sys.stderr.write("hks-layout-check: Quickshell IPC did not become ready.\n")
            return 1

        # Wait until initial service loads settle so real content is present
        for _ in range(40):
            res = subprocess.run(
                ["quickshell", "ipc", "--pid", str(proc.pid), "call", "settings", "debugState"],
                capture_output=True,
                text=True,
                timeout=5,
            )
            if res.returncode == 0:
                st = json.loads(res.stdout.strip())
                if not (
                    st["loading"]
                    or st["display"]["loading"]
                    or st["input"]["loading"]
                    or st["audio"]["loading"]
                    or st["bluetooth"]["loading"]
                    or st["network"]["loading"]
                    or st["themes"]["loading"]
                    or st["power"]["loading"]
                    or st["system"]["loading"]
                    or st["keyboard"]["loading"]
                ):
                    break
            time.sleep(0.15)

        for w, h, tag in matrix:
            size_label = f"{w}x{h} ({tag})"
            first_probe_in_size = True
            for page_id, sub_tab, details_on, expand_all, label in PROBES:
                subprocess.run(
                    [
                        "quickshell",
                        "ipc",
                        "--pid",
                        str(proc.pid),
                        "call",
                        "settings",
                        "debugConfigureLayoutProbe",
                        str(w),
                        str(h),
                        page_id,
                        sub_tab,
                        "true" if details_on else "false",
                        "true" if expand_all else "false",
                    ],
                    check=True,
                    capture_output=True,
                    text=True,
                    timeout=5,
                )
                time.sleep(0.10 if first_probe_in_size else 0.06)
                first_probe_in_size = False
                aud = subprocess.run(
                    ["quickshell", "ipc", "--pid", str(proc.pid), "call", "settings", "debugAuditCurrentLayout"],
                    check=True,
                    capture_output=True,
                    text=True,
                    timeout=5,
                )
                data = json.loads(aud.stdout.strip())
                for v in data.get("violations", []):
                    all_violations.append((
                        label,
                        size_label,
                        v.get("type", ""),
                        v.get("item", ""),
                        f"{v.get('detail', '')} [{v.get('path', '')}]",
                    ))
    finally:
        proc.terminate()
        try:
            logs, _ = proc.communicate(timeout=5)
        except subprocess.TimeoutExpired:
            proc.kill()
            logs, _ = proc.communicate(timeout=5)

    loop_lines = [ln.strip() for ln in logs.splitlines() if "Binding loop" in ln]
    for ln in loop_lines:
        all_violations.append(("runtime", "-", "binding_loop", "QML", ln))

    if all_violations:
        print(f"hks-layout-check: {len(all_violations)} violation(s) across {len(matrix)} size(s) x {len(PROBES)} view(s):")
        print(f"{'PAGE':<24} {'SIZE':<22} {'TYPE':<16} {'ITEM':<32} DETAIL")
        for pg, sz, tp, it, dt in all_violations[:120]:
            print(f"{pg:<24} {sz:<22} {tp:<16} {it[:30]:<32} {dt}")
        if len(all_violations) > 120:
            print(f"... and {len(all_violations) - 120} more")
        return 1

    print(f"hks-layout-check: passed (0 violations across {len(matrix)} sizes x {len(PROBES)} views).")
    if args.screenshots:
        cap_script = repo_root / "scripts" / "ui-capture" / "capture_layout_matrix.py"
        cap_res = subprocess.run([sys.executable, str(cap_script)], check=False)
        if cap_res.returncode != 0:
            return cap_res.returncode
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
