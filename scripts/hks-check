#!/usr/bin/env bash
# =============================================================================
# Hyprland Keybind Studio (HKS) - Verification & Linter Runner
# =============================================================================
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_ROOT"

echo "=== Hyprland Keybind Studio: Verification Check ==="
echo

# 1. Backend Unit Tests
echo "[1/3] Running backend test suite..."
python3 -m unittest discover -s backend/tests -t . -v
echo

# 2. Frontend QML Unit Tests
echo "[2/3] Running frontend QML unit tests..."
if [ -x /usr/lib/qt6/bin/qmltestrunner ]; then
    QMLTESTRUNNER="/usr/lib/qt6/bin/qmltestrunner"
elif command -v qmltestrunner >/dev/null 2>&1; then
    QMLTESTRUNNER="qmltestrunner"
else
    QMLTESTRUNNER=""
fi

if [ -n "$QMLTESTRUNNER" ]; then
    QT_QPA_PLATFORM=offscreen "$QMLTESTRUNNER" -import "$REPO_ROOT/frontend/tests/mocks" -input "$REPO_ROOT/frontend/tests/"
    if [ -d "$REPO_ROOT/settings/tests" ]; then
        QT_QPA_PLATFORM=offscreen "$QMLTESTRUNNER" -import "$REPO_ROOT/frontend/tests/mocks" -input "$REPO_ROOT/settings/tests/"
    fi
    echo "QML unit tests passed successfully."
else
    echo "qmltestrunner not found; skipping QML unit tests."
fi
echo

# 3. Frontend & Settings QML Lint
echo "[3/3] Running qmllint on frontend and settings files..."
if command -v qmllint >/dev/null 2>&1; then
    QML_FILES=($(find frontend settings -name "*.qml" | sort))
    echo "Found ${#QML_FILES[@]} QML files."
    qmllint "${QML_FILES[@]}"
    echo "qmllint passed with 0 errors/warnings."
else
    echo "qmllint not found; skipping QML static analysis."
fi
echo

echo "=== All checks passed successfully! ==="
