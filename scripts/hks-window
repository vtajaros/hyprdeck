#!/usr/bin/env bash
# =============================================================================
# Hyprland Keybind Studio (HKS) - Window Mode Launcher & Toggle
#
#   hks-window            toggle (decided by whether the window is really mapped)
#   hks-window --open     make sure the window is mapped; exit 0 only if it is
#   hks-window --daemon   start a hidden keep-alive instance (no-op if running)
#
# Ground truth is `hyprctl clients -j`, never an IPC exit code: a Quickshell
# FloatingWindow can swallow `visible = true` after a compositor-side close.
# =============================================================================
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
FRONTEND_DIR="$REPO_ROOT/frontend"

HKS_WINDOW_TITLE="${HKS_WINDOW_TITLE:-Hyprland Keybind Studio}"
HKS_WINDOW_CLASS="${HKS_WINDOW_CLASS:-org.quickshell}"
OPEN_WAIT_MS="${HKS_OPEN_WAIT_MS:-1500}"
COLD_WAIT_MS="${HKS_COLD_WAIT_MS:-3000}"
CLOSE_WAIT_MS="${HKS_CLOSE_WAIT_MS:-1500}"

ACTION="toggle"
PASSTHROUGH_ARGS=()
for arg in "$@"; do
    case "$arg" in
        --open)   ACTION="open" ;;
        --daemon) ACTION="daemon" ;;
        *)        PASSTHROUGH_ARGS+=("$arg") ;;
    esac
done

# Matches only the HKS instance ("quickshell -p <repo>/frontend"); never the
# desktop shell's own quickshell, and never short-lived "quickshell ipc" calls.
MATCH_PATTERN="[q]uickshell -p $FRONTEND_DIR"

LOG_FILE="${XDG_RUNTIME_DIR:-/tmp}/hks-window.log"

now_ms() { echo $(( $(date +%s%N) / 1000000 )); }

hks_running() { pgrep -f "$MATCH_PATTERN" >/dev/null 2>&1; }

# Ground truth: a mapped client whose title EQUALS the HKS title exactly and
# whose class is the HKS class (python3 stdlib JSON parsing, no grep).
window_mapped() {
    hyprctl clients -j 2>/dev/null | HKS_T="$HKS_WINDOW_TITLE" HKS_C="$HKS_WINDOW_CLASS" python3 -c '
import json, os, sys
try:
    clients = json.load(sys.stdin)
except Exception:
    sys.exit(1)
t, c = os.environ["HKS_T"], os.environ["HKS_C"]
sys.exit(0 if any(
    isinstance(x, dict) and x.get("title") == t and x.get("class") == c
    and x.get("mapped", True) for x in clients) else 1)
'
}

# poll_state mapped|unmapped <timeout_ms>
poll_state() {
    local want="$1" end
    end=$(( $(now_ms) + $2 ))
    while :; do
        if [ "$want" = "mapped" ]; then
            window_mapped && return 0
        else
            window_mapped || return 0
        fi
        [ "$(now_ms)" -ge "$end" ] && return 1
        sleep 0.05
    done
}

ipc_call() {
    timeout 2 quickshell ipc -p "$FRONTEND_DIR" call hks "$1" >/dev/null 2>&1
}

kill_hks() {
    pkill -f "$MATCH_PATTERN" 2>/dev/null || true
    local i
    for i in $(seq 1 40); do
        hks_running || return 0
        sleep 0.05
    done
    pkill -9 -f "$MATCH_PATTERN" 2>/dev/null || true
    sleep 0.1
}

# start_instance visible|hidden : detached keep-alive instance.
start_instance() {
    if ! command -v quickshell >/dev/null 2>&1; then
        echo "hks-window: quickshell is not installed or not in PATH." >&2
        return 1
    fi
    if ! command -v python3 >/dev/null 2>&1; then
        echo "hks-window: python3 is not installed or not in PATH." >&2
        return 1
    fi
    export HKS_ROOT="$REPO_ROOT"
    export HKS_MODE="window"
    export HKS_KEEP_ALIVE="1"
    export QML_XHR_ALLOW_FILE_READ=1
    if [ "$1" = "hidden" ]; then
        export HKS_START_HIDDEN="1"
    else
        unset HKS_START_HIDDEN
    fi
    setsid quickshell -p "$FRONTEND_DIR" "${PASSTHROUGH_ARGS[@]}" \
        >>"$LOG_FILE" 2>&1 </dev/null &
}

fail_open() {
    echo "hks-window: Hyprland Keybind Studio window did not appear (see $LOG_FILE)." >&2
    exit 1
}

cold_start_visible() {
    start_instance visible || exit 1
    poll_state mapped "$COLD_WAIT_MS"
}

do_open() {
    if ! hks_running; then
        cold_start_visible && return 0
        fail_open
    fi
    local attempt
    for attempt in 1 2; do
        ipc_call open || true
        poll_state mapped "$OPEN_WAIT_MS" && return 0
    done
    # Daemon is alive but wedged: replace it.
    kill_hks
    cold_start_visible && return 0
    fail_open
}

do_toggle() {
    if window_mapped; then
        ipc_call close || true
        poll_state unmapped "$CLOSE_WAIT_MS" && return 0
        kill_hks
        poll_state unmapped "$CLOSE_WAIT_MS" && return 0
        echo "hks-window: could not close the HKS window." >&2
        exit 1
    fi
    do_open
}

case "$ACTION" in
    daemon)
        hks_running && exit 0
        start_instance hidden || exit 1
        # Keep the historical contract (callers execDetached this and may wait);
        # the instance itself is already detached, so just return.
        exit 0
        ;;
    open)   do_open ;;
    toggle) do_toggle ;;
esac
exit 0
